# Run: uv run python -m incident_room.configure
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=medium
PROJECT_CONFIG=
ROOM_TOKENS={}
APP_ENV=local
APP_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Public Web application client ID. No Google client secret is used.
GOOGLE_CLIENT_ID=
AUTH_MEMBERS={}
ALLOW_REVIEWER_TOKENS=true
# Default state: local runtime/room-live.db. Use PostgreSQL for a shared installation.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
# ROOM_DATA_DIR=D:/SwitchHackathon/private-runtime
# Optional authoritative DataHub metadata. Omit datahub_urns to use BigQuery schema plus human context.
DATAHUB_GMS_URL=
DATAHUB_TOKEN=
# Run register_switch only after Switch server setup; these use the agent API key.
SWITCH_BASE_URL=
SWITCH_AGENT_ID=
SWITCH_API_KEY=
SWITCH_ROOM_ID=
# Opaque Switch sender -> {"name":"...","role":"finance|engineering","token":"matching ROOM_TOKENS token"}
SWITCH_MEMBERS={}
# Service key replaces reviewer tokens for verified Google memberships.
SWITCH_ADAPTER_TOKEN=
ROOM_API_URL=http://127.0.0.1:8400
